# Copy is NOT needed: run `vercel env pull .env.local` after linking the project.
# This file documents every variable the app reads. Never put real values here.

# Neon Postgres (added by the Vercel Marketplace integration)
DATABASE_URL=

# Clerk (added by the Vercel Marketplace integration; dev runs keyless without them)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic API (Phase 1)
ANTHROPIC_API_KEY=

# 32 random bytes, base64. Generate and add without ever printing it:
#   openssl rand -base64 32 | vercel env add ENCRYPTION_KEY production
ENCRYPTION_KEY=

# Vercel Blob: on Vercel this uses OIDC automatically; the token is for local dev only
BLOB_READ_WRITE_TOKEN=

# Job sources (Phase 1)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Vercel Cron auth (any long random string)
CRON_SECRET=

# Monthly AI spend ceiling in USD (default 40)
AI_MONTHLY_BUDGET_USD=40
